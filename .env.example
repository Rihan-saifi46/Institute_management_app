# ==============================================================================
# Z Institute Management System - Environment Variable Template
# ==============================================================================
# DO NOT ADD REAL SECRETS OR PRODUCTION CREDENTIALS TO THIS FILE.
# Copy this template to .env or configure in your deployment platform secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client & Migration Operations)
# ------------------------------------------------------------------------------
# Public Supabase API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anonymous Key (safe for frontend distribution with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Direct PostgreSQL Connection String (used strictly for migrations & backups via pg_dump)
# Never expose this variable to the frontend client.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Backup Pipeline Secrets (GitHub Actions / Offsite Storage)
# ------------------------------------------------------------------------------
# GPG Public Encryption Key (Ascii Armored) for asymmetric backup encryption
GPG_PUBLIC_KEY=-----BEGIN PGP PUBLIC KEY BLOCK-----\n...\n-----END PGP PUBLIC KEY BLOCK-----

# Cloudflare R2 S3-Compatible Credentials
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=institute-backups-prod
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Owner Alert Email Recipient
BACKUP_ALERT_EMAIL=saifirihan683@gmail.com

# ------------------------------------------------------------------------------
# Resend Transactional Email Configuration (Decision 3: Server-Side Outbox Worker)
# ------------------------------------------------------------------------------
# API Key from resend.com (Free Plan: 3,000 emails/month, 100 emails/day)
# STRICT SECURITY DIRECTIVE: NEVER prefix with VITE_ or expose to client bundle.
RESEND_API_KEY=re_123456789abcdef

# Sender address:
# - During testing without custom domain: Resend mandates 'onboarding@resend.dev'
# - Once DNS (SPF, DKIM, DMARC) is verified on your domain: 'fees@yourdomain.edu'
RESEND_FROM_EMAIL=Z Institute <onboarding@resend.dev>
