# ==============================================================================
# Client Frontend Environment Template (Vite SPA)
# ==============================================================================
# All variables here are bundled into client-side JavaScript.
# NEVER ADD DATABASE PASSWORDS OR SERVICE_ROLE KEYS TO THIS FILE.
# ==============================================================================

# Supabase Public API URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous Key (Protected by PostgreSQL Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
